<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hopdeck.exe"
        Arguments=""
        InstallLocation="C:\Program Files\SrZafkiell\Hopdeck">
    </Installer>
    <PackageInformation
        PackageName="Hopdeck"
        PackageDisplayName="Hopdeck"
        PublisherName="CN=SrZafkiell"
        PublisherDisplayName="SrZafkiell"
        Version="0.1.0.0"
        PackageDescription="AWS Session Manager tunnels from a shared deck file">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="io.github.srzafkiell.hopdeck"
                Description="AWS Session Manager tunnels from a shared deck file"
                DisplayName="Hopdeck"
                ExecutableName="hopdeck.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Hopdeck</DisplayName>
            <PublisherDisplayName>SrZafkiell</PublisherDisplayName>
            <Description>AWS Session Manager tunnels from a shared deck file</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hopdeck.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
